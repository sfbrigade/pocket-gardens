# Airtable personal access token scope:
#   data.records:read  (required for import)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Anonymous plot creation requires both development mode and explicit opt-in.
ALLOW_ANONYMOUS_PLOT_SUBMISSION=false
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEYPAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_REGION=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_SIGNER_ENDPOINT=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_REGION=
AWS_SES_SECRET_ACCESS_KEY=
BASE_URL=http://localhost:3333
DATABASE_URL=
# npm run dev generates a private local value. For production, explicitly configure
# a private secret, e.g. generate with openssl rand -base64 32.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated IP addresses/CIDRs of the trusted reverse proxy only.
TRUSTED_PROXIES=
SMTP_ENABLED=true
SMTP_FROM_EMAIL_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
VITE_FEATURE_REGISTRATION=true
VITE_SITE_TITLE=Pocket Gardens
VITE_PHOTON_BASE_URL=https://photon.komoot.io
